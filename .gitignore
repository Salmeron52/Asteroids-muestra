.DS_Store

### Gradle ###
.gradle
/build/
/app/build/

# Ignore Gradle GUI config
/gradle-app.setting

# Exclude sources not needed in version control
.idea/libraries/
.idea/modules.xml
.idea/workspace.xml
.idea/vcs.xml

# Avoid ignoring Gradle wrapper jar file (.jar files are usually ignored)
!/gradle/wrapper/gradle-wrapper.jar

# Avoid ignoring Robolelectric native dependencies
!/app/src/test/resources/natives/

# Remove JNI native build files
/app/src/main/jni/obj/
/app/src/main/jni/libs/
/app/src/main/jni/arm64-v8a/
/app/src/main/jni/armeabi-v7a/
/app/src/main/jni/x86/
/app/src/main/jni/x86_64/

### JetpackCompose ###
#ignore kotlin build files
/build/
/app/build
/build/reports
/build/test-results
/build/tmp
/build/kotlin
/build/ksp

